# ─── Email (contact form) ───────────────────────────────────
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# ─── Local dev helpers (optional) ───────────────────────────
# Absolute path to a local checkout of https://github.com/shivaay790/VITON
# Only needed for the /viton/front and /viton/back dev routes.
VITON_PROJECT_PATH=

# Port for server.js (defaults to 8080)
PORT=8080
